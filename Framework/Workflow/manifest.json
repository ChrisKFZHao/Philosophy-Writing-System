  "items": [
    {
      "id": "phil-research",
      "kind": "skill",
      "source": "../Plugin/skills/research/SKILL.md",
      "description": "Work on philosophical sources: ingest PDFs, reconstruct or evaluate an argument, comment on a text, or maintain the philosopher database. Use for 文献入库、论证重构、批判性评估、文本评注、哲学家数据库.",
      "modes": [
        "ingest",
        "reconstruct",
        "evaluate",
        "comment",
        "philosophers"
      ],
      "capabilities": [
        "read",
        "search",
        "write",
        "pdf",
        "zotero-full",
        "zotero-local",
        "delegate"
      ],
      "platforms": [
        "claude",
        "codex"
      ]
    },
    {
      "id": "phil-tutor",
      "kind": "skill",
      "source": "../Plugin/skills/tutor/SKILL.md",
      "description": "Think through a philosophical text or your own thesis in Socratic dialogue. Reading mode probes understanding and suggests what to read next; incubating mode builds a thesis and argument sketch. Use for 读文献讨论、检验理解、构思孵化.",
      "modes": [
        "reading",
        "incubating"
      ],
      "capabilities": [
        "read",
        "search",
        "write"
      ],
      "platforms": [
        "claude",
        "codex"
      ]
    },
    {
      "id": "phil-write",
      "kind": "skill",
      "source": "../Plugin/skills/write/SKILL.md",
      "description": "Write a philosophy manuscript: build an outline from a conception, draft section by section, revise from review findings, or export a talk handout and slides. Use for 写提纲、起草、按审稿意见修改、讲义、幻灯片.",
      "modes": [
        "outline",
        "draft",
        "revision",
        "export"
      ],
      "capabilities": [
        "read",
        "search",
        "write"
      ],
      "platforms": [
        "claude",
        "codex"
      ]
    },
    {
      "id": "phil-review",
      "kind": "skill",
      "source": "../Plugin/skills/review/SKILL.md",
      "description": "Peer review your own philosophy manuscript: a full eight-dimension review, a targeted review, or a re-review of earlier findings. Read-only; revision is handed to phil:write revision. Use for 审稿、复审.",
      "modes": [
        "full",
        "targeted",
        "re-review"
      ],
      "capabilities": [
        "read",
        "search"
      ],
      "platforms": [
        "claude",
        "codex"
      ]
    },
