      "name": "phil",
      "version": "0.7.0-alpha",
      "description": "Philosophical reading and writing workflow: research, tutor, write, review, and a full paper pipeline.",
      "entrypoints": {
        "research": "phil-research",
        "tutor": "phil-tutor",
        "write": "phil-write",
        "review": "phil-review",
        "full": "phil-full"
      }
    }
  },
