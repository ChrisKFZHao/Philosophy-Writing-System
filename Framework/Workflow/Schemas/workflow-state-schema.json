{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phil:workflow-state-schema:1",
  "title": "Project Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "current_stage", "status", "artifacts", "gates", "next_action"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "current_stage": {"type": "integer", "minimum": 0, "maximum": 6},
    "status": {"enum": ["not-started", "in-progress", "paused", "complete"]},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "gates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["stage", "decision", "reason", "recorded_at"], "properties": {"stage": {"type": "integer", "minimum": 0, "maximum": 6}, "decision": {"enum": ["pass", "block", "override"]}, "reason": {"type": "string"}, "recorded_at": {"type": "string", "format": "date-time"}}}},
    "next_action": {"type": ["string", "null"]}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "hash", "workflow", "version", "level", "stale"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "workflow": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "level": {"type": ["number", "null"], "minimum": 0}, "stale": {"type": "boolean"}}}
  }
}
