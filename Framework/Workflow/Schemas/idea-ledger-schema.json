{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phil:idea-ledger-schema:1",
  "title": "Idea Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "next_id", "ideas"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "next_id": {"type": "integer", "minimum": 1},
    "ideas": {"type": "array", "items": {"$ref": "#/$defs/idea"}}
  },
  "$defs": {
    "timestamp": {"type": "string", "format": "date-time"},
    "idea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "provenance", "status_reason", "revival_triggers", "keywords", "related_bib_keys", "superseded_by", "created_at", "updated_at", "last_surfaced_at", "last_surfaced_reason"],
      "properties": {
        "id": {"type": "string", "pattern": "^IDEA-[0-9]{3,}$"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["active", "parked", "rejected", "superseded"]},
        "provenance": {"enum": ["user", "ai-completion", "joint"]},
        "status_reason": {"type": "string"},
        "revival_triggers": {"type": "array", "maxItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["event", "description"], "properties": {"event": {"enum": ["new-evidence", "related-objection", "scope-change", "argument-stall", "defect-resolved", "alternative-failed", "user-request"]}, "description": {"type": "string", "minLength": 1}}}},
        "keywords": {"type": "array", "maxItems": 5, "items": {"type": "string", "minLength": 1}},
        "related_bib_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "superseded_by": {"type": ["string", "null"]},
        "created_at": {"$ref": "#/$defs/timestamp"},
        "updated_at": {"$ref": "#/$defs/timestamp"},
        "last_surfaced_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "last_surfaced_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "superseded"}}, "required": ["status"]},
          "then": {"properties": {"superseded_by": {"type": "string", "pattern": "^IDEA-[0-9]{3,}$"}}},
          "else": {"properties": {"superseded_by": {"type": "null"}}}
        }
      ]
    }
  }
}
