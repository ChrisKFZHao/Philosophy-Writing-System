{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phil:analysis-metadata-schema:1",
  "title": "Analysis Verification Metadata",
  "description": "Evidence required to allow a bibliography analysis through the Citation Gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bib_key",
    "analysis_level",
    "verification_status",
    "source_path",
    "source_sha256",
    "analysis_path",
    "analysis_sha256",
    "coverage",
    "workflow_id",
    "workflow_version",
    "generated_at",
    "verified_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "bib_key": {"type": "string", "minLength": 1},
    "analysis_level": {"type": "number", "enum": [0.5, 1, 2, 3]},
    "verification_status": {"type": "string", "enum": ["provisional", "verified", "stale"]},
    "source_path": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_path": {"type": "string", "minLength": 1},
    "analysis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "workflow_id": {"type": "string", "minLength": 1},
    "workflow_version": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "verified_at": {"type": ["string", "null"], "format": "date-time"}
  }
}
